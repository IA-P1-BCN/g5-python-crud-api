# Local Docker PostgreSQL
DATABASE_URL=postgresql+psycopg://postgres:change_me@db:5432/escape_room

POSTGRES_DB=escape_room
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Supabase Auth
SUPABASE_URL=
SUPABASE_JWT_SECRET=

# Optional: shared Supabase PostgreSQL database for team development.
# When defined, the API uses this database instead of DATABASE_URL.
# Keep real credentials only in the local .env file.
# SHARED_DATABASE_URL=postgresql://postgres.<PROJECT_REF>:<PASSWORD>@<SUPABASE_HOST>:5432/postgres

# Optional: override the database used specifically by Alembic.
# ALEMBIC_DATABASE_URL=postgresql://...